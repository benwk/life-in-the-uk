{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "Questions",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stationId", "factIds", "type", "prompt", "options", "answer", "explanation", "difficulty", "examEligible"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q-[a-z0-9-]+-[0-9]{3}$" },
          "stationId": { "type": "string", "pattern": "^st-[a-z0-9-]+$" },
          "factIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "type": {
            "description": "single / multiple (choose two) / true_false / statement (which is correct) appear in the real test. order and match are practice-only mini games.",
            "enum": ["single", "multiple", "true_false", "statement", "order", "match"]
          },
          "prompt": { "$ref": "common.schema.json#/$defs/localizedText" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "$ref": "common.schema.json#/$defs/localizedText" },
                "matchText": { "$ref": "common.schema.json#/$defs/localizedText" }
              }
            }
          },
          "answer": {
            "description": "Correct option ids. For order questions this is the correct sequence; for match questions every option id in option order (each option's text pairs with its own matchText).",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "explanation": { "$ref": "common.schema.json#/$defs/localizedText" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "examEligible": { "type": "boolean" },
          "traps": { "type": "array", "items": { "enum": ["negation", "choose-two", "absolute", "similar-dates", "similar-names"] } },
          "translationQuality": { "$ref": "common.schema.json#/$defs/translationQuality" },
          "retired": { "type": "boolean" }
        }
      }
    }
  }
}
