{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lines.schema.json",
  "title": "Journey lines and stations",
  "type": "object",
  "required": ["lines"],
  "additionalProperties": false,
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapter", "color", "title", "stations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^line-[a-z0-9-]+$" },
          "chapter": { "type": "integer", "minimum": 1 },
          "color": { "type": "string", "description": "Design token name, see docs/design/design-brief.md" },
          "title": { "$ref": "common.schema.json#/$defs/localizedText" },
          "stations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "minutes", "stampIcon"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^st-[a-z0-9-]+$" },
                "title": { "$ref": "common.schema.json#/$defs/localizedText" },
                "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 15 },
                "stampIcon": { "type": "string" },
                "retired": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
